# Small default model profile (good for low-VRAM tests)
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
PARALLEL_REQUESTS=2
GPU_COUNT=1

# Optional runtime tuning
OPENAI_API_KEY=EMPTY
# Translation source mode: vllm (local API), external (OpenAI-compatible provider), or offline (vLLM Python engine)
INFERENCE_SOURCE=vllm
# External mode settings (used when INFERENCE_SOURCE=external or --inference-source external)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
HF_TOKEN=
VLLM_PORT=8000
GPU_MEMORY_UTILIZATION=0.9
MAX_MODEL_LEN=2048
# Optional: leave empty for full precision (for example: awq for AWQ models)
VLLM_QUANTIZATION=
# Optional vLLM scheduler/memory tuning (leave empty to keep vLLM defaults)
# VLLM_MAX_NUM_SEQS=1
# VLLM_MAX_NUM_BATCHED_TOKENS=2048
# VLLM_ENFORCE_EAGER=0

# Optional offline vLLM tuning (used when INFERENCE_SOURCE=offline)
# OFFLINE_TENSOR_PARALLEL_SIZE=1
# OFFLINE_GPU_MEMORY_UTILIZATION=0.9
# OFFLINE_MAX_MODEL_LEN=2048
# OFFLINE_MAX_NUM_SEQS=
# OFFLINE_MAX_NUM_BATCHED_TOKENS=
# OFFLINE_ENFORCE_EAGER=0
# OFFLINE_DTYPE=auto
# OFFLINE_MAX_OUTPUT_TOKENS=2048
# OFFLINE_MICRO_BATCH_SIZE=150

# Pair-style prompt mode for nq_qa / hotpotqa: few-shot (default) or no-few-shot
# PAIR_PROMPT_MODE=few-shot
